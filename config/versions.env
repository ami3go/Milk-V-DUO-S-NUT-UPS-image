# Reproducibility pins for the Milk-V Duo S UPS appliance image.

ARMBIAN_REPO=https://github.com/armbian/build.git
ARMBIAN_REF=998cebde2dae965f7d0b50cb44a4c20ed951cfb3
ARMBIAN_BOARD=milkv-duos-arm
ARMBIAN_BRANCH=edge
ARMBIAN_RELEASE=trixie

COCKPIT_UPS_WOL_REPO=https://github.com/ami3go/cockpit-ups-wol.git
COCKPIT_UPS_WOL_REF=4959372f252001a576f0b3dedfaecc0a3d2a4d75

# Build toolchain versions used by CI for the application package.
GO_VERSION=1.26.x
NODE_VERSION=24.x

# Increment when the appliance-layer defaults change independently of either
# upstream source pin.
IMAGE_REVISION=0.1.0-dev
